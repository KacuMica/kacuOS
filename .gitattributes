# Normalize line endings so the repo behaves the same on Windows and Linux.
# Shell/Python scripts must keep LF: they run inside the Arch ISO.
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.toml  text eol=lf
*.conf  text eol=lf
*.ini   text eol=lf
*.cfg   text eol=lf

# Windows-only helpers keep CRLF.
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary assets.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.iso   binary
*.qcow2 binary
