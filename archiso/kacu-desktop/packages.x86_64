# ==========================================================================
# kacuOS live/install ISO — package list (x86_64)
#
# Base:    Arch Linux (built with mkarchiso/archiso)
# Desktop: minimal GNOME on Wayland (gnome-shell + mutter + gdm)
# Target:  Intel Core 2 Duo class, HDD, 4 GB RAM
#          (low-RAM tuning lives in airootfs: zram + masked services)
#
# One package or group per line. Blank lines and full-line '#' comments are
# allowed. Do NOT use inline (trailing) comments: mkarchiso strips the
# comment text but leaves the trailing spaces behind, and pacman then fails
# with "target not found: <pkg>   ". The file is sanitized by CI as a
# safety net, but keep it clean anyway.
# The list is intentionally "minimal but usable": it boots to a GNOME
# session, has networking, audio and enough tooling to develop and to
# install kacuOS onto a disk. Everything else is a "box" installed later
# with `kacu-pkg install <box>` (see kacu-pkg/).
# ==========================================================================

# --- Boot / live environment core ----------------------------------------
base
linux
linux-firmware
intel-ucode
amd-ucode
mkinitcpio
mkinitcpio-archiso
sudo
nano
man-db
less
bash-completion

# --- Kernel / hardware support -------------------------------------------
alsa-utils
sof-firmware
usbutils
pciutils

# --- Networking ----------------------------------------------------------
networkmanager
wpa_supplicant
wireless-regdb

# --- Storage + disk-install tooling (Live/Install ISO) -------------------
parted
gptfdisk
dosfstools
e2fsprogs
exfatprogs
ntfs-3g
efibootmgr
grub
os-prober
arch-install-scripts

# --- Minimal GNOME (Wayland) ---------------------------------------------
gnome-shell
mutter
gnome-session
gnome-settings-daemon
gnome-control-center
gnome-keyring
gnome-console
nautilus
gvfs
xdg-user-dirs
xdg-desktop-portal-gnome
xdg-utils
adwaita-icon-theme
gnome-themes-extra
gdm
polkit
accountsservice
upower
power-profiles-daemon

# --- Audio / graphics stack ----------------------------------------------
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
mesa
xorg-xwayland

# --- Fonts ---------------------------------------------------------------
noto-fonts
noto-fonts-emoji
ttf-dejavu
ttf-liberation

# --- Low-RAM / HDD optimizations -----------------------------------------
zram-generator

# --- Development / scripting (so the ISO itself is dev-ready) ------------
git
python
python-pip
lua
neovim
micro
gcc
make
pkgconf
cmake

# --- Bootloader support (BIOS boot of the ISO; UEFI uses systemd-boot) ----
syslinux
memtest86+
memtest86+-efi
edk2-shell
